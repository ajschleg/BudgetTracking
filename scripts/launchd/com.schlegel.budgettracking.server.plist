<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schlegel.budgettracking.server</string>

    <!-- Run the Plaid proxy server. Absolute node@22 path so it keeps
         working even if Homebrew unlinks the unversioned `node`. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/node@22/bin/node</string>
        <string>/Users/austinschlegel/PersonalProjects/BudgetTracking/server/server.js</string>
    </array>

    <!-- dotenv loads .env relative to the working directory. -->
    <key>WorkingDirectory</key>
    <string>/Users/austinschlegel/PersonalProjects/BudgetTracking/server</string>

    <!-- Run as the user (not root) so .env / .encryption-key / plaid.db
         stay owned by austinschlegel with their 0600 perms intact. -->
    <key>UserName</key>
    <string>austinschlegel</string>
    <key>GroupName</key>
    <string>staff</string>

    <!-- Start at boot (before login) and restart on crash. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Don't thrash if it crashes on startup. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/opt/node@22/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/austinschlegel/Library/Logs/BudgetTracking/server.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/austinschlegel/Library/Logs/BudgetTracking/server.err.log</string>
</dict>
</plist>
